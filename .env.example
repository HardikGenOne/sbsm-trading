# Copy to .env; generate distinct random secrets of at least 32 characters.
SBSM_ADMIN_TOKEN=replace-with-a-long-random-admin-secret
SBSM_WEBHOOK_TOKEN=replace-with-a-different-random-webhook-secret
SBSM_DATABASE_URL=sqlite:///data/paper.db
SBSM_FEED_MODE=kite
# These are market-data credentials ONLY. No live order adapter exists.
SBSM_KITE_API_KEY=
SBSM_KITE_ACCESS_TOKEN=
SBSM_INITIAL_CAPITAL_PAISE=50000000
SBSM_ALLOCATION_BPS=1200
SBSM_APPROVED_CONFIG=lb=4;gap=0.16;noise=15;atr=15;factor=1.8;wma=20
# Entry expiration includes time waiting for a quote; expired entries never replay.
SBSM_ENTRY_TTL_SECONDS=60
SBSM_SIGNAL_MAX_AGE_SECONDS=120
SBSM_EXECUTION_LATENCY_MS=500
SBSM_QUOTE_MAX_AGE_SECONDS=10
SBSM_SLIPPAGE_BPS=5
SBSM_PRICE_PROTECTION_BPS=100
SBSM_DEPTH_PARTICIPATION_BPS=1000
# Conservative simulation assumptions, not certified broker charge rates.
SBSM_BUY_COST_BPS=15
SBSM_SELL_COST_BPS=15
SBSM_SELL_FIXED_COST_PAISE=2000
# Conservative: hold all net sale proceeds until next trading-session open.
SBSM_SETTLEMENT_MODE=next_session
SBSM_POLL_SECONDS=2
SBSM_CLOSED_DATES=[]
