# Save actual values in project-root .env.cloud, which is gitignored.
SBSM_DOMAIN=paper.example.com
SBSM_PUBLIC_BASE_URL=https://paper.example.com
SBSM_ALLOWED_HOSTS=["paper.example.com","127.0.0.1","localhost"]
SBSM_ADMIN_TOKEN=replace-with-a-random-admin-token-at-least-32-characters
SBSM_WEBHOOK_TOKEN=replace-with-a-different-random-webhook-token
SBSM_ENVIRONMENT=production
SBSM_SESSION_COOKIE_SECURE=true
SBSM_DATABASE_URL=sqlite:////app/data/paper.db
SBSM_FORWARDED_ALLOW_IPS=172.30.88.2
# Official TradingView source IPv4 list; review before deployment.
SBSM_WEBHOOK_ALLOWED_IPS=["52.89.214.238","34.212.75.30","54.218.53.128","52.32.178.7"]
SBSM_FEED_MODE=kite
SBSM_KITE_API_KEY=
SBSM_KITE_ACCESS_TOKEN=
SBSM_INITIAL_CAPITAL_PAISE=50000000
SBSM_ALLOCATION_BPS=1200
SBSM_APPROVED_CONFIG=lb=3;gap=0.16;noise=25;atr=25;factor=4;wma=30
SBSM_SETTLEMENT_MODE=next_session
SBSM_TELEGRAM_ENABLED=false
SBSM_TELEGRAM_BOT_TOKEN=
SBSM_TELEGRAM_CHAT_ID=
SBSM_TELEGRAM_ALLOW_GROUPS=false
